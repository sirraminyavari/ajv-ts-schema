{
  "name": "@raminy/ajv-ts-schema",
  "description": "Simplify AJV Schema Validation with TypeScript",
  "version": "1.1.0",
  "license": "Apache-2.0",
  "private": false,
  "repository": "https://github.com/sirraminyavari/ajv-ts-schema",
  "homepage": "https://www.raminy.dev/article/18712bd0-e06d-80b2-8e76-f86720b48d01/Simplifying%20AJV%20Schema%20Validation%20with%20TypeScript/ajv-ts-schema",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.umd.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.umd.js"
    }
  },
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "lint": "eslint",
    "fix": "eslint --fix",
    "prepare": "husky",
    "release:ci": "release-it --ci",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "author": {
    "name": "Ramin Yavari",
    "url": "https://raminy.dev"
  },
  "keywords": [
    "ajv",
    "ts-ajv",
    "typescript-ajv",
    "ajv-ts",
    "typescript-schema-validation",
    "ts-schema-validation",
    "json-schema",
    "json-schema-validation",
    "json-schema-validator",
    "schema-validator",
    "validation",
    "validator"
  ],
  "release-it": {
    "git": {
      "commitMessage": "chore: Release ${version}",
      "tagName": "${version}",
      "requireCleanWorkingDir": true,
      "commit": true,
      "push": true,
      "tag": true
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": true,
      "tokenRef": "GITHUB_TOKEN"
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "infile": "CHANGELOG.md",
        "preset": "angular"
      }
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts,json}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "release-it": "^21.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  }
}
